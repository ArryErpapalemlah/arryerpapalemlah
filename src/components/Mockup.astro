---
// Abstract, monochrome UI previews for project cards (no real screenshots needed).
import type { Visual } from "../data/profile";
interface Props { variant: Visual; dark?: boolean }
const { variant, dark = false } = Astro.props;

const bg = dark ? "#18181b" : "#f4f4f5";
const panel = dark ? "#232326" : "#ffffff";
const line = dark ? "#3f3f46" : "#e4e4e7";
const ink = dark ? "#e4e4e7" : "#27272a";
const mute = dark ? "#52525b" : "#d4d4d8";
const bars = [38, 62, 48, 80, 56, 92, 70];
---
<svg viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" class="mockup" aria-hidden="true">
  <rect width="400" height="250" fill={bg} />

  {variant === "dashboard" && (
    <g>
      <rect x="0" y="0" width="70" height="250" fill={panel} stroke={line} />
      {[30, 50, 70, 90, 110].map((y) => <rect x="14" y={y} width="42" height="6" rx="3" fill={mute} />)}
      {[0, 1, 2].map((i) => (
        <g>
          <rect x={84 + i * 104} y="16" width="96" height="54" rx="8" fill={panel} stroke={line} />
          <rect x={94 + i * 104} y="28" width="40" height="5" rx="2.5" fill={mute} />
          <rect x={94 + i * 104} y="42" width="58" height="12" rx="3" fill={ink} />
        </g>
      ))}
      <rect x="84" y="80" width="200" height="156" rx="8" fill={panel} stroke={line} />
      {bars.map((h, i) => <rect x={102 + i * 25} y={220 - h * 1.2} width="14" height={h * 1.2} rx="3" fill={i === 5 ? ink : mute} />)}
      <rect x="292" y="80" width="96" height="156" rx="8" fill={panel} stroke={line} />
      <circle cx="340" cy="130" r="28" fill="none" stroke={mute} stroke-width="10" />
      <circle cx="340" cy="130" r="28" fill="none" stroke={ink} stroke-width="10" stroke-dasharray="110 200" transform="rotate(-90 340 130)" />
      {[180, 196, 212].map((y) => <rect x="304" y={y} width="72" height="6" rx="3" fill={mute} />)}
    </g>
  )}

  {variant === "test" && (
    <g>
      <rect x="40" y="18" width="320" height="232" rx="12" fill={panel} stroke={line} />
      <rect x="60" y="38" width="90" height="8" rx="4" fill={mute} />
      <rect x="290" y="34" width="50" height="16" rx="8" fill={ink} />
      <rect x="60" y="58" width="280" height="5" rx="2.5" fill={line} />
      <rect x="60" y="58" width="170" height="5" rx="2.5" fill={ink} />
      <rect x="60" y="82" width="250" height="10" rx="4" fill={ink} />
      <rect x="60" y="98" width="180" height="10" rx="4" fill={ink} />
      {[0, 1, 2, 3].map((i) => (
        <g>
          <rect x="60" y={124 + i * 28} width="280" height="22" rx="7" fill={i === 1 ? ink : panel} stroke={i === 1 ? ink : line} />
          <circle cx="76" cy={135 + i * 28} r="5" fill="none" stroke={i === 1 ? panel : mute} stroke-width="2" />
          <rect x="90" y={132 + i * 28} width={[120, 150, 100, 135][i]} height="6" rx="3" fill={i === 1 ? panel : mute} />
        </g>
      ))}
    </g>
  )}

  {variant === "network" && (
    <g stroke={line} stroke-width="1.5" fill="none">
      {[[80, 60], [80, 190], [320, 60], [320, 190], [200, 215], [200, 35]].map(([x, y]) => (
        <path d={`M200 125 C ${(200 + x) / 2} 125, ${(200 + x) / 2} ${y}, ${x} ${y}`} />
      ))}
      <circle cx="200" cy="125" r="30" fill={panel} stroke={ink} />
      <path d="M188 128h24M200 116v24" stroke={ink} stroke-width="2" />
      {[[80, 60], [80, 190], [320, 60], [320, 190], [200, 215], [200, 35]].map(([x, y]) => (
        <g>
          <rect x={x - 34} y={y - 13} width="68" height="26" rx="8" fill={panel} />
          <circle cx={x - 20} cy={y} r="5" fill={mute} stroke="none" />
          <rect x={x - 10} y={y - 3} width="34" height="6" rx="3" fill={mute} stroke="none" />
        </g>
      ))}
    </g>
  )}

  {variant === "mobile" && (
    <g>
      {[0, 1].map((i) => (
        <g transform={`translate(${110 + i * 100} ${i ? 40 : 20})`}>
          <rect width="84" height="200" rx="14" fill={panel} stroke={line} />
          <rect x="10" y="16" width="40" height="6" rx="3" fill={mute} />
          <rect x="10" y="30" width="64" height={i ? 64 : 48} rx="8" fill={ink} />
          {i === 0 && <circle cx="42" cy="110" r="22" fill="none" stroke={ink} stroke-width="2" stroke-dasharray="6 4" />}
          {i === 0 && <circle cx="42" cy="106" r="7" fill={mute} />}
          {(i ? [104, 122, 140, 158] : [146, 160]).map((y) => <rect x="10" y={y} width="64" height="10" rx="4" fill={mute} />)}
          <rect x="10" y="178" width="64" height="12" rx="6" fill={ink} />
        </g>
      ))}
    </g>
  )}

  {variant === "store" && (
    <g>
      <rect x="0" y="0" width="400" height="34" fill={panel} stroke={line} />
      <rect x="16" y="12" width="56" height="10" rx="3" fill={ink} />
      <rect x="250" y="10" width="134" height="14" rx="7" fill={bg} stroke={line} />
      <rect x="16" y="48" width="70" height="190" rx="8" fill={panel} stroke={line} />
      {[64, 80, 96, 112, 128].map((y) => <rect x="26" y={y} width="48" height="6" rx="3" fill={mute} />)}
      {[0, 1, 2].map((c) => [0, 1].map((r) => (
        <g>
          <rect x={98 + c * 98} y={48 + r * 98} width="88" height="90" rx="8" fill={panel} stroke={line} />
          <rect x={106 + c * 98} y={56 + r * 98} width="72" height="50" rx="5" fill={(c + r) % 2 ? mute : ink} opacity={(c + r) % 2 ? 1 : 0.85} />
          <rect x={106 + c * 98} y={114 + r * 98} width="50" height="6" rx="3" fill={mute} />
          <rect x={106 + c * 98} y={124 + r * 98} width="28" height="6" rx="3" fill={ink} />
        </g>
      )))}
    </g>
  )}

  {variant === "landing" && (
    <g>
      <rect x="0" y="0" width="400" height="30" fill={panel} />
      <rect x="16" y="11" width="44" height="8" rx="3" fill={ink} />
      {[260, 294, 328].map((x) => <rect x={x} y="12" width="26" height="6" rx="3" fill={mute} />)}
      <rect x="24" y="56" width="150" height="14" rx="4" fill={ink} />
      <rect x="24" y="76" width="120" height="14" rx="4" fill={ink} />
      <rect x="24" y="100" width="140" height="6" rx="3" fill={mute} />
      <rect x="24" y="112" width="110" height="6" rx="3" fill={mute} />
      <rect x="24" y="130" width="64" height="20" rx="10" fill={ink} />
      <rect x="200" y="46" width="176" height="114" rx="10" fill={panel} stroke={line} />
      <path d="M220 140 L265 90 L295 120 L320 98 L356 140 Z" fill={mute} />
      <polygon points="288,60 304,52 320,60 320,78 288,78" fill={ink} />
      {[0, 1, 2].map((i) => <rect x={24 + i * 120} y="176" width="110" height="62" rx="8" fill={panel} stroke={line} />)}
    </g>
  )}
</svg>

<style>
  .mockup { width: 100%; height: 100%; display: block; }
</style>
